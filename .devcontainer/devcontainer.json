{
  "name": "redcarpet-form-extension",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "bash -lc 'bin/setup'",
  "postStartCommand": "bash -lc 'ruby -v && bundle -v'",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "misogi.ruby-rubocop",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  }
}